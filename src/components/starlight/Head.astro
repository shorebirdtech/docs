---
import Default from '@astrojs/starlight/components/Head.astro';
import { getImagePath } from 'astro-opengraph-images';
import { markdownSiblingPath } from '~/utils/markdown-path';
import { unlistedPages } from '~/unlisted';

const ogImageUrl = getImagePath({ url: Astro.url, site: Astro.site });

// Unlisted pages have no `.md` sibling (see `src/pages/[...slug].md.ts`).
const { entry } = Astro.locals.starlightRoute;
const markdownPath = unlistedPages.includes(entry.id)
  ? undefined
  : markdownSiblingPath(Astro.url.pathname);
---

<Default><slot /></Default>
<meta property="og:image" content={ogImageUrl} />
<meta property="twitter:image" content={ogImageUrl} />
<meta
  name="keywords"
  content="Shorebird, Shorebird Code Push, Shorebird Flutter, Code Push, Flutter Code Push, Flutter OTA updates, Over-the-air updates Flutter, Flutter hotfix, Shorebird CLI"
/>
<meta name="application-name" content="Shorebird Code Push" />
<meta name="apple-mobile-web-app-title" content="Shorebird" />
<meta name="subject" content="Flutter Code Push and Over-the-Air Updates" />
<meta
  name="topic"
  content="Flutter, Code Push, Mobile App Development, Over-the-Air Updates"
/>
<meta
  name="summary"
  content="Shorebird provides instant Code Push and over-the-air updates for Flutter applications across all supported platforms."
/>
<meta name="author" content="Shorebird, Inc." />

<!-- AI Agent Discovery & Alternate Formats -->
{
  markdownPath && (
    <link rel="alternate" type="text/markdown" href={markdownPath} />
  )
}
<link
  rel="alternate"
  type="text/plain"
  href="/llms.txt"
  title="LLMs Overview"
/>
<link
  rel="ai-catalog"
  type="application/ai-catalog+json"
  href="/.well-known/ai-catalog.json"
/>
<link
  rel="api-catalog"
  type="application/linkset+json"
  href="/.well-known/api-catalog"
/>
<link
  rel="agent-skills"
  type="application/json"
  href="/.well-known/agent-skills/index.json"
/>
<link rel="agent" type="application/json" href="/.well-known/agent.json" />
<link
  rel="search"
  type="application/opensearchdescription+xml"
  title="Shorebird Docs"
  href="/opensearch.xml"
/>
<link rel="author" type="text/plain" href="/humans.txt" />

<!-- WebMCP / In-Browser Model Context Provider -->
<!-- cspell:disable -->
<script is:inline>
  (function () {
    if (
      typeof window !== 'undefined' &&
      'modelContext' in navigator &&
      typeof navigator.modelContext?.provideContext === 'function'
    ) {
      try {
        navigator.modelContext.provideContext({
          name: 'Shorebird Documentation',
          description:
            'Official documentation and tooling for Shorebird Flutter Code Push.',
          tools: [
            {
              name: 'get_install_command',
              description:
                'Returns the official Shorebird CLI installation command for macOS/Linux or Windows.',
              parameters: {
                type: 'object',
                properties: {
                  os: {
                    type: 'string',
                    enum: ['unix', 'windows'],
                    description: 'Target operating system',
                  },
                },
                required: ['os'],
              },
              execute: function (args) {
                if (args && args.os === 'windows') {
                  return 'powershell -executionpolicy bypass -command "irm https://shorebird.dev/install.ps1 | iex"';
                }
                return 'curl -fsSL https://shorebird.dev/install.sh | bash';
              },
            },
            {
              name: 'get_llms_txt_url',
              description:
                'Returns the URL of the curated Shorebird documentation for LLMs.',
              parameters: { type: 'object', properties: {} },
              execute: function () {
                return 'https://docs.shorebird.dev/llms.txt';
              },
            },
          ],
        });
      } catch (e) {
        // Silently ignore if modelContext provider fails
      }
    }
  })();
</script>
<!-- cspell:enable -->

