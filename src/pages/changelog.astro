---
// cspell:ignore beforematch data-type nums white-space
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  AREAS,
  CHANGELOG_DESCRIPTION,
  CHANGELOG_TITLE,
  ENTRIES,
  groupByMonth,
  releaseNotesUrl,
  type ChangelogEntry,
} from '~/data/changelog';

const TYPE_LABEL_COLOR: Record<ChangelogEntry['type'], string> = {
  New: 'new',
  Fixed: 'fixed',
  Changed: 'changed',
  Deprecated: 'deprecated',
};

const groups = groupByMonth(ENTRIES);

// Only offer a chip for an area that has entries, so no filter starts empty.
const areas = AREAS.filter((a) => ENTRIES.some((e) => e.area === a));

function formatDay(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<StarlightPage
  frontmatter={{
    title: CHANGELOG_TITLE,
    description: CHANGELOG_DESCRIPTION,
    head: [
      {
        tag: 'link',
        attrs: {
          rel: 'alternate',
          type: 'application/rss+xml',
          title: 'Shorebird changelog',
          href: '/changelog.xml',
        },
      },
    ],
  }}
  headings={groups.map((g) => ({ depth: 2, slug: g.id, text: g.label }))}
>
  <p>
    What we shipped to Code Push, the CLI, and the API. Expand an entry for the
    full detail, the command, and the doc it belongs to. Subscribe with the <a
      href="/changelog.xml">RSS feed</a
    >.
  </p>

  <div class="cl-toolbar not-content">
    <div class="cl-search">
      <svg
        class="cl-search-icon"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"
        ></circle>
        <path
          d="M21 21l-4.3-4.3"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
      <input
        id="cl-search"
        type="search"
        placeholder="Search the changelog"
        aria-label="Search the changelog"
      />
    </div>
    <div class="cl-chips" role="group" aria-label="Filter by area">
      {
        ['All', ...areas].map((a) => (
          <button
            class:list={['cl-chip', { 'is-active': a === 'All' }]}
            data-area={a}
            type="button"
            aria-pressed={a === 'All' ? 'true' : 'false'}
          >
            {a}
            <span class="cl-chip-count">
              {a === 'All'
                ? ENTRIES.length
                : ENTRIES.filter((e) => e.area === a).length}
            </span>
          </button>
        ))
      }
    </div>
    {/* The chips show the counts; this tells screen reader users. */}
    <span class="sr-only" id="cl-count" aria-live="polite"></span>
  </div>

  <div class="cl-list" id="cl-list">
    {
      groups.map((group) => (
        <section class="cl-group">
          <h2 class="cl-month" id={group.id}>
            {group.label}
          </h2>
          {group.items.map((e) => {
            const searchText = [
              e.title,
              e.summary,
              e.area,
              e.type,
              e.version,
              ...e.bullets,
              e.code ?? '',
            ]
              .join(' ')
              .replaceAll('`', '')
              .toLowerCase();
            return (
              <article
                class="cl-entry"
                id={e.id}
                data-area={e.area}
                data-type={TYPE_LABEL_COLOR[e.type]}
                data-search={searchText}
              >
                <div class="cl-when">
                  <time datetime={e.date}>{formatDay(e.date)}</time>
                  <span class="cl-version">CLI {e.version}</span>
                </div>
                <div class="cl-body">
                  <div class="cl-head">
                    <button
                      class="cl-entry-toggle"
                      id={`${e.id}-toggle`}
                      type="button"
                      aria-expanded="false"
                      aria-controls={`${e.id}-detail`}
                      aria-labelledby={`${e.id}-title ${e.id}-toggle`}
                    >
                      <span
                        class="cl-badge"
                        data-type={TYPE_LABEL_COLOR[e.type]}
                      >
                        {e.type}
                      </span>
                      <span class="cl-badge cl-badge-area">{e.area}</span>
                      <span class="cl-mark" aria-hidden="true">
                        <svg viewBox="0 0 16 16" width="12" height="12">
                          <path
                            d="M2 8h12"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                          />
                          <path
                            class="cl-mark-v"
                            d="M8 2v12"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                          />
                        </svg>
                      </span>
                    </button>
                    <h3 class="cl-title" id={`${e.id}-title`}>
                      {e.title}
                    </h3>
                    <p class="cl-summary">
                      {e.summary
                        .split('`')
                        .map((part, i) => (i % 2 ? <code>{part}</code> : part))}
                    </p>
                  </div>
                  {/* until-found lets the browser's find-in-page match text in
                      a collapsed entry; the beforematch handler then opens it. */}
                  <div
                    class="cl-detail"
                    id={`${e.id}-detail`}
                    hidden="until-found"
                  >
                    <ul class="cl-bullets">
                      {e.bullets.map((b) => (
                        <li>
                          {b
                            .split('`')
                            .map((part, i) =>
                              i % 2 ? <code>{part}</code> : part,
                            )}
                        </li>
                      ))}
                    </ul>
                    {e.code && (
                      <pre class="cl-code"><code>$ {e.code}</code></pre>
                    )}
                    <div class="cl-footer">
                      {e.docLink && (
                        <a href={e.docLink.href} class="cl-doc-link">
                          {e.docLink.label} →
                        </a>
                      )}
                      <a
                        href={releaseNotesUrl(e.version)}
                        class="cl-notes-link"
                      >
                        Release notes ↗
                      </a>
                      <a
                        href={`#${e.id}`}
                        class="cl-copy"
                        data-copy={`#${e.id}`}
                      >
                        <svg
                          viewBox="0 0 24 24"
                          width="14"
                          height="14"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
                          <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
                        </svg>
                        <span class="cl-copy-label">Copy link</span>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </section>
      ))
    }
  </div>

  <p class="cl-empty" id="cl-empty" hidden>
    Nothing matches that search. Clear the field or pick a different area.
  </p>
</StarlightPage>

<script>
  function init() {
    const search = document.getElementById(
      'cl-search',
    ) as HTMLInputElement | null;
    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.cl-chip'),
    );
    const entries = Array.from(
      document.querySelectorAll<HTMLElement>('.cl-entry'),
    );
    const groups = Array.from(
      document.querySelectorAll<HTMLElement>('.cl-group'),
    );
    const countEl = document.getElementById('cl-count');
    const emptyEl = document.getElementById('cl-empty');
    if (!search || !countEl || !emptyEl) return;

    let area = 'All';
    let lastQuery = '';

    function applyFilters() {
      const q = (search?.value ?? '').trim().toLowerCase();
      let visibleCount = 0;
      // Per-area matches for the current search, ignoring the area filter,
      // so each chip says how many entries picking it would show.
      const areaCounts = new Map<string, number>([['All', 0]]);

      for (const entry of entries) {
        const entryArea = entry.dataset.area ?? '';
        const matchesSearch =
          q === '' || (entry.dataset.search ?? '').includes(q);
        if (matchesSearch) {
          areaCounts.set('All', areaCounts.get('All')! + 1);
          areaCounts.set(entryArea, (areaCounts.get(entryArea) ?? 0) + 1);
        }
        const visible = matchesSearch && (area === 'All' || entryArea === area);
        entry.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      for (const chip of chips) {
        const n = areaCounts.get(chip.dataset.area ?? '') ?? 0;
        const countSpan = chip.querySelector('.cl-chip-count');
        if (countSpan) countSpan.textContent = String(n);
        chip.classList.toggle('is-empty', n === 0);
      }

      for (const group of groups) {
        const hasVisible = group.querySelector('.cl-entry:not([hidden])');
        group.hidden = !hasVisible;
      }

      // Announce only after the reader changes something, not on page load.
      if (q !== lastQuery || area !== 'All' || countEl!.textContent) {
        countEl!.textContent = `${visibleCount} ${visibleCount === 1 ? 'entry' : 'entries'}`;
      }
      lastQuery = q;
      emptyEl!.hidden = visibleCount !== 0;
    }

    search.addEventListener('input', applyFilters);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        area = chip.dataset.area ?? 'All';
        for (const c of chips) {
          c.classList.toggle('is-active', c === chip);
          c.setAttribute('aria-pressed', String(c === chip));
        }
        applyFilters();
      });
    }

    function setOpen(entry: HTMLElement, open: boolean) {
      const toggle = entry.querySelector<HTMLButtonElement>('.cl-entry-toggle');
      const detail = entry.querySelector<HTMLElement>('.cl-detail');
      if (!toggle || !detail) return;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) detail.removeAttribute('hidden');
      else detail.setAttribute('hidden', 'until-found');
    }

    for (const entry of entries) {
      const toggle = entry.querySelector<HTMLButtonElement>('.cl-entry-toggle');
      if (!toggle) continue;
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        setOpen(entry, !isOpen);
      });
      // Clicking the title or summary toggles too, unless the click was
      // the end of a text selection or landed on a link.
      entry.querySelector('.cl-head')?.addEventListener('click', (ev) => {
        const target = ev.target as Element;
        if (toggle.contains(target) || target.closest('a')) return;
        if (window.getSelection()?.toString()) return;
        toggle.click();
      });
      entry
        .querySelector('.cl-detail')
        ?.addEventListener('beforematch', () => setOpen(entry, true));
    }

    for (const copyBtn of document.querySelectorAll<HTMLAnchorElement>(
      '.cl-copy',
    )) {
      // No preventDefault: following the link puts the permalink in the
      // address bar, which is the fallback when the clipboard is unavailable.
      copyBtn.addEventListener('click', async () => {
        const hash = copyBtn.dataset.copy ?? '';
        const url = `${location.origin}${location.pathname}${hash}`;
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          // Clipboard access can fail (permissions, insecure context).
          return;
        }
        const label = copyBtn.querySelector('.cl-copy-label');
        if (!label) return;
        label.textContent = 'Copied';
        copyBtn.classList.add('is-copied');
        setTimeout(() => {
          label.textContent = 'Copy link';
          copyBtn.classList.remove('is-copied');
        }, 1500);
      });
    }

    // Open and scroll to the entry named in the URL hash, if any. Also runs
    // on hashchange, so a permalink followed from this same page opens too.
    function openFromHash() {
      const targetId = decodeURIComponent(location.hash.replace(/^#/, ''));
      if (!targetId) return;
      const target = document.getElementById(targetId);
      if (target?.classList.contains('cl-entry')) {
        setOpen(target, true);
        target.scrollIntoView({ block: 'start' });
      }
    }

    openFromHash();
    window.addEventListener('hashchange', openFromHash);

    applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  /* Toolbar */

  .cl-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 0.5rem;
  }

  .cl-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 14rem;
    height: 2.5rem;
    padding: 0 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg-sidebar);
    transition: border-color 0.15s;
  }

  .cl-search:focus-within {
    border-color: var(--sl-color-gray-3);
  }

  .cl-search-icon {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
  }

  .cl-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    font-size: 0.9rem;
  }

  .cl-search input::placeholder {
    color: var(--sl-color-gray-3);
  }

  .cl-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cl-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.5rem 0 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s,
      opacity 0.15s;
  }

  .cl-chip:hover {
    border-color: var(--sl-color-gray-3);
  }

  .cl-chip-count {
    min-width: 1.25rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-gray-4) 22%, transparent);
    font-size: 0.7rem;
    line-height: 1.25rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .cl-chip.is-active {
    background: var(--sl-color-white);
    border-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .cl-chip.is-active .cl-chip-count {
    background: color-mix(in srgb, var(--sl-color-black) 14%, transparent);
  }

  .cl-chip.is-empty:not(.is-active) {
    opacity: 0.45;
  }

  /* Timeline. Each entry is a date gutter and a body; the bodies' left
     borders join into one line, with a dot per entry in its type's color. */

  .cl-list {
    container-type: inline-size;
  }

  .cl-group {
    margin-top: 2.25rem;
  }

  .cl-month {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    border: 0;
    padding: 0;
  }

  /* Starlight's content styles put a top margin between sibling blocks,
     which would open gaps in the timeline line. */
  .cl-entry,
  .cl-when,
  .cl-body,
  .cl-head {
    margin: 0;
  }

  .cl-entry {
    --cl-dot: var(--sl-color-gray-4);
    display: grid;
    grid-template-columns: 6rem 1fr;
    column-gap: 1.25rem;
  }

  .cl-entry[data-type='new'] {
    --cl-dot: #22c55e;
  }
  .cl-entry[data-type='fixed'] {
    --cl-dot: #3b82f6;
  }
  .cl-entry[data-type='changed'] {
    --cl-dot: #a855f7;
  }
  .cl-entry[data-type='deprecated'] {
    --cl-dot: #f59e0b;
  }

  .cl-when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    padding-top: 1.1rem;
    text-align: right;
  }

  .cl-when time {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }

  .cl-version {
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }

  .cl-body {
    position: relative;
    min-width: 0;
    padding: 1rem 0 1.25rem 1.5rem;
    border-left: 1px solid var(--sl-color-gray-5);
  }

  .cl-body::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    left: -0.3125rem;
    width: 0.5625rem;
    height: 0.5625rem;
    border-radius: 50%;
    background: var(--cl-dot);
    box-shadow: 0 0 0 0.25rem var(--sl-color-bg);
  }

  /* The button holds only the badge row; a click handler on the header
     makes the title and summary toggle too, while leaving their text
     selectable. */
  .cl-head {
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .cl-head:has(.cl-entry-toggle:focus-visible) {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 0.35rem;
  }

  .cl-entry-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
    outline: 0;
  }

  .cl-badge {
    height: 1.25rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.25rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .cl-badge-area {
    background: color-mix(in srgb, var(--sl-color-gray-4) 18%, transparent);
    color: var(--sl-color-gray-2);
  }

  /* Each type gets its own hue rather than the theme accent, which is gray
     and made New look like the area badge next to it. Light-mode text shades
     are dark enough for 4.5:1 contrast on their tinted pill at this size. */
  .cl-badge[data-type='new'] {
    background: color-mix(in srgb, #22c55e 16%, transparent);
    color: #166534;
  }

  .cl-badge[data-type='fixed'] {
    background: color-mix(in srgb, #3b82f6 16%, transparent);
    color: #1d4ed8;
  }

  .cl-badge[data-type='changed'] {
    background: color-mix(in srgb, #a855f7 16%, transparent);
    color: #7e22ce;
  }

  .cl-badge[data-type='deprecated'] {
    background: color-mix(in srgb, #f59e0b 16%, transparent);
    color: #92400e;
  }

  :root[data-theme='dark'] .cl-badge[data-type='new'] {
    color: #4ade80;
  }
  :root[data-theme='dark'] .cl-badge[data-type='fixed'] {
    color: #93c5fd;
  }
  :root[data-theme='dark'] .cl-badge[data-type='changed'] {
    color: #d8b4fe;
  }
  :root[data-theme='dark'] .cl-badge[data-type='deprecated'] {
    color: #fbbf24;
  }

  .cl-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-left: auto;
    border-radius: 50%;
    background: color-mix(in srgb, var(--sl-color-gray-4) 16%, transparent);
    color: var(--sl-color-gray-2);
    transition:
      background 0.15s,
      color 0.15s;
  }

  .cl-mark svg {
    display: block;
  }

  .cl-head:hover .cl-mark {
    background: color-mix(in srgb, var(--sl-color-gray-4) 32%, transparent);
    color: var(--sl-color-white);
  }

  .cl-entry-toggle[aria-expanded='true'] .cl-mark-v {
    display: none;
  }

  .cl-title {
    margin: 0.5rem 0 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--sl-color-white);
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s;
  }

  .cl-head:hover .cl-title {
    text-decoration-color: var(--sl-color-gray-4);
  }

  .cl-summary {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  /* Detail */

  .cl-detail {
    margin-top: 0.9rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-6, var(--sl-color-gray-5));
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
  }

  /* The sidebar background is white in light mode, the same as the page. */
  :root[data-theme='light'] .cl-detail {
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
  }

  /* hidden="until-found" keeps the box rendered with its content hidden, so
     drop the spacing that would otherwise leave an empty panel. */
  .cl-detail[hidden] {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cl-bullets {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .cl-code {
    margin: 0.9rem 0 0;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    overflow-x: auto;
    white-space: pre;
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.82rem;
    color: var(--sl-color-gray-1);
  }

  /* Starlight's inline-code border and padding would box the command a
     second time inside the block. */
  .cl-code code {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
  }

  .cl-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.9rem;
    font-size: 0.85rem;
  }

  .cl-doc-link {
    font-weight: 600;
  }

  .cl-notes-link {
    color: var(--sl-color-gray-2);
  }

  .cl-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    text-decoration: none;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .cl-copy:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }

  .cl-copy.is-copied {
    border-color: #22c55e;
    color: var(--sl-color-white);
  }

  .cl-empty {
    margin-top: 1.5rem;
    padding: 1.5rem 0;
    color: var(--sl-color-gray-2);
  }

